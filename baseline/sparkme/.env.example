# Model configuration
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME="gpt-4o-mini"

# Optional dedicated agent models
AGENDA_MANAGER_MODEL_NAME="gpt-4o-mini"
# AGENDA_MANAGER_VLLM_BASE_URL=http://localhost:8000/v1
EXPLORATION_PLANNER_MODEL_NAME="gpt-4o-mini"
# EXPLORATION_PLANNER_VLLM_BASE_URL=http://localhost:8000/v1

# Optional alternative model providers
# TOGETHER_API_KEY=
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
# GCP_PROJECT=
# GCP_REGION=
# GCP_CREDENTIALS=

# Embedding backend: "openai", "vllm", or "noop"
EMBEDDING_BACKEND="openai"

# Agent consideration loop
MAX_EVENTS_LEN=10
MAX_CONSIDERATION_ITERATIONS=4

# Exploration Planner configuration
EXPLORATION_PLANNER_TURN_TRIGGER=3
EXPLORATION_PLANNER_NUM_ROLLOUTS=3
EXPLORATION_PLANNER_ROLLOUT_HORIZON=3
EXPLORATION_PLANNER_MAX_QUESTIONS=5
EXPLORATION_PLANNER_ALPHA=0.5
EXPLORATION_PLANNER_BETA=0.3
EXPLORATION_PLANNER_GAMMA=0.2

# Runtime directory
LOGS_DIR="logs"
