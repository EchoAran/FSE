    "line": 122,
    "snippet": "def shuffle_board() -> list[list[int]]:"
  },
  {
    "path": "app.py",
    "line": 123,
    "snippet": "    while True:"
  },
  {
    "path": "app.py",
    "line": 124,
    "snippet": "        tiles = list(range(9))"
  },
  {
    "path": "app.py",
    "line": 125,
    "snippet": "        random.shuffle(tiles)"
  },
  {
    "path": "app.py",
    "line": 126,
    "snippet": "        board = [tiles[i:i + 3] for i in range(0, 9, 3)]"
  },
  {
    "path": "app.py",
    "line": 127,
    "snippet": "        inv = sum(1 for i in range(8) for j in range(i + 1, 9) if tiles[i] and tiles[j] and tiles[i] > tiles[j])"
  },
  {
    "path": "app.py",
    "line": 128,
    "snippet": "        if inv % 2 == 0 and not solved(board):"
  },
  {
    "path": "app.py",
    "line": 129,
    "snippet": "            return board"
  },
