  {
    "path": "app.py",
    "line": 95,
    "snippet": "def find_zero(board: list[list[int]]) -> tuple[int, int]:"
  },
  {
    "path": "app.py",
    "line": 96,
    "snippet": "    for r, row in enumerate(board):"
  },
  {
    "path": "app.py",
    "line": 97,
    "snippet": "        for c, n in enumerate(row):"
  },
  {
    "path": "app.py",
    "line": 98,
    "snippet": "            if n == 0:"
  },
  {
    "path": "app.py",
    "line": 99,
    "snippet": "                return r, c"
  },
  {
    "path": "app.py",
    "line": 100,
    "snippet": "    raise ValueError('no zero tile')"
  },
  {
    "path": "app.py",
    "line": 101,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 102,
