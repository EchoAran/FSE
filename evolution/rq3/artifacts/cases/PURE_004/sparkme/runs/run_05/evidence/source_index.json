  },
  {
    "path": "app.py",
    "line": 103,
    "snippet": "def move_tile(board: list[list[int]], tile: int) -> tuple[bool, str]:"
  },
  {
    "path": "app.py",
    "line": 104,
    "snippet": "    zr, zc = find_zero(board)"
  },
  {
    "path": "app.py",
    "line": 105,
    "snippet": "    tr = tc = -1"
  },
  {
    "path": "app.py",
    "line": 106,
    "snippet": "    for r, row in enumerate(board):"
  },
  {
    "path": "app.py",
    "line": 107,
    "snippet": "        for c, n in enumerate(row):"
  },
  {
    "path": "app.py",
    "line": 108,
    "snippet": "            if n == tile:"
  },
  {
    "path": "app.py",
    "line": 109,
    "snippet": "                tr, tc = r, c"
  },
  {
    "path": "app.py",
    "line": 110,
    "snippet": "    if tr < 0:"
  },
  {
    "path": "app.py",
    "line": 111,
    "snippet": "        return False, 'Invalid move: tile not found.'"
  },
  {
    "path": "app.py",
    "line": 112,
    "snippet": "    if abs(tr - zr) + abs(tc - zc) != 1:"
  },
  {
    "path": "app.py",
    "line": 113,
    "snippet": "        return False, 'Invalid move: tile must be adjacent to the empty space.'"
  },
  {
    "path": "app.py",
    "line": 114,
    "snippet": "    board[zr][zc], board[tr][tc] = board[tr][tc], board[zr][zc]"
  },
  {
    "path": "app.py",
    "line": 115,
    "snippet": "    return True, 'Move accepted.'"
  },
  {
