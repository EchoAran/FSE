  {
    "path": "app.py",
    "line": 118,
    "snippet": "def solved(board: list[list[int]]) -> bool:"
  },
  {
    "path": "app.py",
    "line": 119,
    "snippet": "    return [n for row in board for n in row] == [1, 2, 3, 4, 5, 6, 7, 8, 0]"
  },
