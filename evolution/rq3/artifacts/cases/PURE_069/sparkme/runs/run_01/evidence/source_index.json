    "snippet": "def parse_page_spec(spec: str, page_count: int) -> List[int]:"
  },
  {
    "path": "pdf_tool.py",
    "line": 12,
    "snippet": "    pages: List[int] = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 13,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "pdf_tool.py",
    "line": 14,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "pdf_tool.py",
    "line": 15,
    "snippet": "        if not part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 16,
    "snippet": "            continue"
  },
  {
    "path": "pdf_tool.py",
    "line": 17,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 18,
    "snippet": "            start_s, end_s = part.split('-', 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 19,
    "snippet": "            start = int(start_s)"
  },
  {
    "path": "pdf_tool.py",
    "line": 20,
    "snippet": "            end = int(end_s)"
  },
  {
    "path": "pdf_tool.py",
    "line": 21,
    "snippet": "            step = 1 if end >= start else -1"
  },
  {
    "path": "pdf_tool.py",
    "line": 22,
    "snippet": "            for p in range(start, end + step, step):"
  },
  {
    "path": "pdf_tool.py",
    "line": 23,
    "snippet": "                if 1 <= p <= page_count:"
  },
  {
    "path": "pdf_tool.py",
    "line": 24,
    "snippet": "                    pages.append(p - 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 25,
    "snippet": "        else:"
  },
  {
    "path": "pdf_tool.py",
    "line": 26,
    "snippet": "            p = int(part)"
  },
  {
    "path": "pdf_tool.py",
    "line": 27,
    "snippet": "            if 1 <= p <= page_count:"
  },
  {
    "path": "pdf_tool.py",
    "line": 28,
    "snippet": "                pages.append(p - 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 29,
    "snippet": "    return pages"
  },
