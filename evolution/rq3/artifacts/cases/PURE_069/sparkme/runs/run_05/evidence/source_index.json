    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 10,
    "snippet": "class PDFToolError(Exception):"
  },
  {
    "path": "app.py",
    "line": 11,
    "snippet": "    pass"
  },
  {
    "path": "app.py",
    "line": 12,
