  },
  {
    "path": "app.py",
    "line": 14,
    "snippet": "def load_pdf(path: Path) -> PdfReader:"
  },
  {
    "path": "app.py",
    "line": 15,
    "snippet": "    if not path.exists():"
  },
  {
    "path": "app.py",
    "line": 16,
    "snippet": "        raise PDFToolError(f\"Input file not found: {path}\")"
  },
  {
    "path": "app.py",
    "line": 17,
    "snippet": "    try:"
  },
  {
    "path": "app.py",
    "line": 18,
    "snippet": "        return PdfReader(str(path))"
  },
  {
    "path": "app.py",
    "line": 19,
    "snippet": "    except Exception as e:"
  },
  {
    "path": "app.py",
    "line": 20,
    "snippet": "        raise PDFToolError(f\"Failed to read PDF '{path}': {e}\") from e"
  },
  {
    "path": "app.py",
    "line": 21,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 22,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 23,
    "snippet": "def save_writer(writer: PdfWriter, output: Path) -> None:"
  },
  {
    "path": "app.py",
    "line": 24,
    "snippet": "    output.parent.mkdir(parents=True, exist_ok=True)"
  },
  {
    "path": "app.py",
    "line": 25,
    "snippet": "    with output.open('wb') as f:"
  },
  {
    "path": "app.py",
    "line": 26,
    "snippet": "        writer.write(f)"
  },
  {
    "path": "app.py",
    "line": 27,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 28,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 29,
    "snippet": "def split_pdf(input_path: Path, output_dir: Path, pages_per_file: int) -> list[str]:"
  },
  {
    "path": "app.py",
    "line": 30,
    "snippet": "    reader = load_pdf(input_path)"
  },
  {
    "path": "app.py",
    "line": 31,
    "snippet": "    outputs = []"
  },
  {
    "path": "app.py",
    "line": 32,
    "snippet": "    total = len(reader.pages)"
  },
  {
    "path": "app.py",
    "line": 33,
    "snippet": "    for start in range(0, total, pages_per_file):"
  },
  {
    "path": "app.py",
    "line": 34,
    "snippet": "        writer = PdfWriter()"
  },
  {
    "path": "app.py",
    "line": 35,
    "snippet": "        for i in range(start, min(start + pages_per_file, total)):"
  },
  {
    "path": "app.py",
    "line": 36,
    "snippet": "            writer.add_page(reader.pages[i])"
  },
  {
    "path": "app.py",
    "line": 37,
    "snippet": "        out = output_dir / f\"{input_path.stem}_part_{start+1:03d}-{min(start+pages_per_file,total):03d}.pdf\""
  },
  {
    "path": "app.py",
    "line": 38,
    "snippet": "        save_writer(writer, out)"
  },
  {
    "path": "app.py",
    "line": 39,
    "snippet": "        outputs.append(str(out))"
  },
  {
    "path": "app.py",
    "line": 40,
    "snippet": "    return outputs"
  },
  {
    "path": "app.py",
    "line": 41,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 42,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 43,
    "snippet": "def merge_pdfs(inputs: list[Path], output: Path) -> None:"
  },
  {
    "path": "app.py",
    "line": 44,
    "snippet": "    writer = PdfWriter()"
  },
  {
    "path": "app.py",
    "line": 45,
    "snippet": "    for p in inputs:"
  },
  {
    "path": "app.py",
    "line": 46,
    "snippet": "        reader = load_pdf(p)"
  },
  {
    "path": "app.py",
    "line": 47,
    "snippet": "        for page in reader.pages:"
  },
  {
    "path": "app.py",
    "line": 48,
    "snippet": "            writer.add_page(page)"
  },
  {
    "path": "app.py",
    "line": 49,
    "snippet": "    save_writer(writer, output)"
  },
  {
    "path": "app.py",
    "line": 50,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 51,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 52,
    "snippet": "def extract_pages(input_path: Path, output: Path, pages: list[int]) -> None:"
  },
  {
    "path": "app.py",
    "line": 53,
    "snippet": "    reader = load_pdf(input_path)"
  },
  {
    "path": "app.py",
    "line": 54,
    "snippet": "    writer = PdfWriter()"
  },
  {
    "path": "app.py",
    "line": 55,
    "snippet": "    for page_num in pages:"
  },
  {
    "path": "app.py",
    "line": 56,
    "snippet": "        if page_num < 1 or page_num > len(reader.pages):"
  },
  {
    "path": "app.py",
    "line": 57,
    "snippet": "            raise PDFToolError(f\"Page out of range: {page_num}\")"
  },
  {
    "path": "app.py",
    "line": 58,
    "snippet": "        writer.add_page(reader.pages[page_num - 1])"
  },
  {
    "path": "app.py",
    "line": 59,
    "snippet": "    save_writer(writer, output)"
  },
  {
    "path": "app.py",
    "line": 60,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 61,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 62,
    "snippet": "def rotate_pages(input_path: Path, output: Path, pages: list[int], degrees: int) -> None:"
  },
  {
    "path": "app.py",
    "line": 63,
    "snippet": "    if degrees % 90 != 0:"
  },
  {
    "path": "app.py",
    "line": 64,
    "snippet": "        raise PDFToolError(\"Rotation must be a multiple of 90\")"
  },
  {
    "path": "app.py",
    "line": 65,
    "snippet": "    reader = load_pdf(input_path)"
  },
  {
    "path": "app.py",
    "line": 66,
    "snippet": "    writer = PdfWriter()"
  },
  {
    "path": "app.py",
    "line": 67,
    "snippet": "    for idx, page in enumerate(reader.pages, start=1):"
  },
  {
    "path": "app.py",
    "line": 68,
    "snippet": "        if not pages or idx in pages:"
  },
  {
    "path": "app.py",
    "line": 69,
    "snippet": "            if degrees > 0:"
  },
  {
    "path": "app.py",
    "line": 70,
    "snippet": "                page.rotate(degrees)"
  },
  {
    "path": "app.py",
    "line": 71,
    "snippet": "            else:"
  },
  {
    "path": "app.py",
    "line": 72,
    "snippet": "                page.rotate(degrees)"
  },
  {
    "path": "app.py",
    "line": 73,
    "snippet": "        writer.add_page(page)"
  },
  {
    "path": "app.py",
    "line": 74,
    "snippet": "    save_writer(writer, output)"
  },
  {
    "path": "app.py",
    "line": 75,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 76,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 77,
    "snippet": "def reorder_pages(input_path: Path, output: Path, order: list[int]) -> None:"
  },
  {
    "path": "app.py",
    "line": 78,
    "snippet": "    reader = load_pdf(input_path)"
  },
  {
    "path": "app.py",
    "line": 79,
    "snippet": "    if sorted(order) != list(range(1, len(reader.pages) + 1)):"
  },
  {
    "path": "app.py",
    "line": 80,
    "snippet": "        raise PDFToolError(\"Order must include each page number exactly once\")"
  },
  {
    "path": "app.py",
    "line": 81,
    "snippet": "    writer = PdfWriter()"
  },
  {
    "path": "app.py",
    "line": 82,
    "snippet": "    for page_num in order:"
  },
  {
    "path": "app.py",
    "line": 83,
    "snippet": "        writer.add_page(reader.pages[page_num - 1])"
  },
  {
    "path": "app.py",
    "line": 84,
    "snippet": "    save_writer(writer, output)"
  },
  {
    "path": "app.py",
    "line": 85,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 86,
    "snippet": ""
  },
  {
    "path": "app.py",
    "line": 87,
    "snippet": "def parse_pages(spec: str) -> list[int]:"
  },
  {
    "path": "app.py",
    "line": 88,
    "snippet": "    pages = []"
  },
  {
    "path": "app.py",
    "line": 89,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "app.py",
    "line": 90,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "app.py",
    "line": 91,
    "snippet": "        if not part:"
  },
  {
    "path": "app.py",
    "line": 92,
    "snippet": "            continue"
  },
  {
    "path": "app.py",
    "line": 93,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "app.py",
    "line": 94,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "app.py",
    "line": 95,
    "snippet": "            pages.extend(range(int(a), int(b) + 1))"
  },
  {
    "path": "app.py",
    "line": 96,
    "snippet": "        else:"
  },
  {
    "path": "app.py",
    "line": 97,
    "snippet": "            pages.append(int(part))"
  },
  {
    "path": "app.py",
    "line": 98,
    "snippet": "    return pages"
  },
  {
