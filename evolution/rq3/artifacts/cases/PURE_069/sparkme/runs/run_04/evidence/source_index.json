    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "pdfsm/app.py",
    "line": 13,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "pdfsm/app.py",
    "line": 14,
    "snippet": "        if not part:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 15,
    "snippet": "            continue"
  },
  {
    "path": "pdfsm/app.py",
    "line": 16,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 17,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "pdfsm/app.py",
    "line": 18,
    "snippet": "            start = int(a)"
  },
  {
    "path": "pdfsm/app.py",
    "line": 19,
    "snippet": "            end = int(b)"
  },
  {
    "path": "pdfsm/app.py",
    "line": 20,
    "snippet": "            if start <= end:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 21,
    "snippet": "                pages.extend(range(start, end + 1))"
  },
  {
    "path": "pdfsm/app.py",
    "line": 22,
    "snippet": "            else:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 23,
    "snippet": "                pages.extend(range(start, end - 1, -1))"
  },
  {
    "path": "pdfsm/app.py",
    "line": 24,
    "snippet": "        else:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 25,
    "snippet": "            pages.append(int(part))"
  },
  {
    "path": "pdfsm/app.py",
    "line": 26,
    "snippet": "    seen = set()"
  },
  {
    "path": "pdfsm/app.py",
    "line": 27,
    "snippet": "    result = []"
  },
  {
    "path": "pdfsm/app.py",
    "line": 28,
    "snippet": "    for p in pages:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 29,
    "snippet": "        if p < 1 or p > max_pages:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 30,
    "snippet": "            raise ValueError(f'page {p} out of range 1..{max_pages}')"
  },
  {
    "path": "pdfsm/app.py",
    "line": 31,
    "snippet": "        if p not in seen:"
  },
  {
    "path": "pdfsm/app.py",
    "line": 32,
    "snippet": "            seen.add(p)"
  },
  {
    "path": "pdfsm/app.py",
    "line": 33,
    "snippet": "            result.append(p)"
  },
  {
    "path": "pdfsm/app.py",
    "line": 34,
    "snippet": "    return result"
