    "path": "pdf_tool.py",
    "line": 42,
    "snippet": "def parse_pages(spec: str, total_pages: int) -> List[int]:"
  },
  {
    "path": "pdf_tool.py",
    "line": 43,
    "snippet": "    pages = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 44,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "pdf_tool.py",
    "line": 45,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "pdf_tool.py",
    "line": 46,
    "snippet": "        if not part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 47,
    "snippet": "            continue"
  },
  {
    "path": "pdf_tool.py",
    "line": 48,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 49,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 50,
    "snippet": "            start = int(a)"
  },
  {
    "path": "pdf_tool.py",
    "line": 51,
    "snippet": "            end = int(b)"
  },
  {
    "path": "pdf_tool.py",
    "line": 52,
    "snippet": "            step = 1 if end >= start else -1"
  },
  {
    "path": "pdf_tool.py",
    "line": 53,
    "snippet": "            for n in range(start, end + step, step):"
  },
  {
    "path": "pdf_tool.py",
    "line": 54,
    "snippet": "                pages.append(n)"
  },
  {
    "path": "pdf_tool.py",
    "line": 55,
    "snippet": "        else:"
  },
  {
    "path": "pdf_tool.py",
    "line": 56,
    "snippet": "            pages.append(int(part))"
  },
  {
    "path": "pdf_tool.py",
    "line": 57,
    "snippet": "    out = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 58,
    "snippet": "    for p in pages:"
  },
  {
    "path": "pdf_tool.py",
    "line": 59,
    "snippet": "        if p < 1 or p > total_pages:"
  },
  {
    "path": "pdf_tool.py",
    "line": 60,
    "snippet": "            raise ValueError(f\"page {p} out of range 1..{total_pages}\")"
  },
  {
    "path": "pdf_tool.py",
    "line": 61,
    "snippet": "        out.append(p - 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 62,
    "snippet": "    return out"
  },
