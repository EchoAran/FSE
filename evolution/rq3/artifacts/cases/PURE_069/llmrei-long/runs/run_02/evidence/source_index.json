  {
    "path": "pdf_tool.py",
    "line": 21,
    "snippet": "    pages: List[int] = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 22,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "pdf_tool.py",
