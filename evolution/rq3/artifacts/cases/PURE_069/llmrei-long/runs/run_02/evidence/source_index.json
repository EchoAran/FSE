    "snippet": "        if not part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 25,
    "snippet": "            continue"
  },
  {
    "path": "pdf_tool.py",
    "line": 26,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 27,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 28,
    "snippet": "            start, end = int(a), int(b)"
  },
  {
    "path": "pdf_tool.py",
    "line": 29,
    "snippet": "            step = 1 if end >= start else -1"
  },
  {
    "path": "pdf_tool.py",
    "line": 30,
    "snippet": "            pages.extend(list(range(start, end + step, step)))"
  },
  {
    "path": "pdf_tool.py",
    "line": 31,
    "snippet": "        else:"
  },
  {
    "path": "pdf_tool.py",
    "line": 32,
    "snippet": "            pages.append(int(part))"
  },
  {
    "path": "pdf_tool.py",
    "line": 33,
    "snippet": "    return pages"
  },
