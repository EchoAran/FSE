    "path": "pdf_tool.py",
    "line": 22,
    "snippet": "def _parse_pages(spec: str, total_pages: int) -> List[int]:"
  },
  {
    "path": "pdf_tool.py",
    "line": 23,
    "snippet": "    pages: List[int] = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 24,
    "snippet": "    if not spec:"
  },
  {
    "path": "pdf_tool.py",
    "line": 25,
    "snippet": "        return pages"
  },
  {
    "path": "pdf_tool.py",
    "line": 26,
    "snippet": "    for part in spec.split(\",\"):"
  },
  {
    "path": "pdf_tool.py",
    "line": 27,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "pdf_tool.py",
    "line": 28,
    "snippet": "        if not part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 29,
    "snippet": "            continue"
  },
  {
    "path": "pdf_tool.py",
    "line": 30,
    "snippet": "        if \"-\" in part:"
  },
  {
    "path": "pdf_tool.py",
    "line": 31,
    "snippet": "            start_s, end_s = part.split(\"-\", 1)"
  },
  {
    "path": "pdf_tool.py",
    "line": 32,
    "snippet": "            start = int(start_s)"
  },
  {
    "path": "pdf_tool.py",
    "line": 33,
    "snippet": "            end = int(end_s)"
  },
  {
    "path": "pdf_tool.py",
    "line": 34,
    "snippet": "            if start < 1 or end < start:"
  },
  {
    "path": "pdf_tool.py",
    "line": 35,
    "snippet": "                raise ValueError(f\"Invalid page range: {part}\")"
  },
  {
    "path": "pdf_tool.py",
    "line": 36,
    "snippet": "            pages.extend(range(start, min(end, total_pages) + 1))"
  },
  {
    "path": "pdf_tool.py",
    "line": 37,
    "snippet": "        else:"
  },
  {
    "path": "pdf_tool.py",
    "line": 38,
    "snippet": "            page = int(part)"
  },
  {
    "path": "pdf_tool.py",
    "line": 39,
    "snippet": "            if page < 1 or page > total_pages:"
  },
  {
    "path": "pdf_tool.py",
    "line": 40,
    "snippet": "                raise ValueError(f\"Invalid page number: {part}\")"
  },
  {
    "path": "pdf_tool.py",
    "line": 41,
    "snippet": "            pages.append(page)"
  },
  {
    "path": "pdf_tool.py",
    "line": 42,
    "snippet": "    seen = set()"
  },
  {
    "path": "pdf_tool.py",
    "line": 43,
    "snippet": "    result = []"
  },
  {
    "path": "pdf_tool.py",
    "line": 44,
    "snippet": "    for p in pages:"
  },
  {
    "path": "pdf_tool.py",
    "line": 45,
    "snippet": "        if p not in seen:"
  },
  {
    "path": "pdf_tool.py",
    "line": 46,
    "snippet": "            seen.add(p)"
  },
  {
    "path": "pdf_tool.py",
    "line": 47,
    "snippet": "            result.append(p)"
  },
  {
    "path": "pdf_tool.py",
    "line": 48,
    "snippet": "    return result"
  },
