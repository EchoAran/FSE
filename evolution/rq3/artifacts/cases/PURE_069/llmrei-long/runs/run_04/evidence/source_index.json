    "path": "app.py",
    "line": 28,
    "snippet": "def parse_pages(spec: str, total: int) -> List[int]:"
  },
  {
    "path": "app.py",
    "line": 29,
    "snippet": "    out = []"
  },
  {
    "path": "app.py",
    "line": 30,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "app.py",
    "line": 31,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "app.py",
    "line": 32,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "app.py",
    "line": 33,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "app.py",
    "line": 34,
    "snippet": "            rng = range(int(a), int(b) + 1)"
  },
  {
    "path": "app.py",
    "line": 35,
    "snippet": "            out.extend(rng)"
  },
  {
    "path": "app.py",
    "line": 36,
    "snippet": "        else:"
  },
  {
    "path": "app.py",
    "line": 37,
    "snippet": "            out.append(int(part))"
  },
  {
    "path": "app.py",
    "line": 38,
    "snippet": "    dedup = []"
  },
  {
    "path": "app.py",
    "line": 39,
    "snippet": "    for p in out:"
  },
  {
    "path": "app.py",
    "line": 40,
    "snippet": "        if p < 1 or p > total:"
  },
  {
    "path": "app.py",
    "line": 41,
    "snippet": "            raise ValueError(f'page {p} out of range 1..{total}')"
  },
  {
    "path": "app.py",
    "line": 42,
    "snippet": "        if p not in dedup:"
  },
  {
    "path": "app.py",
    "line": 43,
    "snippet": "            dedup.append(p)"
  },
  {
    "path": "app.py",
    "line": 44,
    "snippet": "    return dedup"
  },
