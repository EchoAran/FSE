    "path": "app.py",
    "line": 16,
    "snippet": "def parse_page_spec(spec: str, page_count: int) -> List[int]:"
  },
  {
    "path": "app.py",
    "line": 17,
    "snippet": "    if not spec.strip():"
  },
  {
    "path": "app.py",
    "line": 18,
    "snippet": "        return list(range(page_count))"
  },
  {
    "path": "app.py",
    "line": 19,
    "snippet": "    result: List[int] = []"
  },
  {
    "path": "app.py",
    "line": 20,
    "snippet": "    seen = set()"
  },
  {
    "path": "app.py",
    "line": 21,
    "snippet": "    for part in spec.split(','):"
  },
  {
    "path": "app.py",
    "line": 22,
    "snippet": "        part = part.strip()"
  },
  {
    "path": "app.py",
    "line": 23,
    "snippet": "        if not part:"
  },
  {
    "path": "app.py",
    "line": 24,
    "snippet": "            continue"
  },
  {
    "path": "app.py",
    "line": 25,
    "snippet": "        if '-' in part:"
  },
  {
    "path": "app.py",
    "line": 26,
    "snippet": "            a, b = part.split('-', 1)"
  },
  {
    "path": "app.py",
    "line": 27,
    "snippet": "            start = int(a)"
  },
  {
    "path": "app.py",
    "line": 28,
    "snippet": "            end = int(b)"
  },
  {
    "path": "app.py",
    "line": 29,
    "snippet": "            if start < 1 or end < 1 or start > page_count or end > page_count:"
  },
  {
    "path": "app.py",
    "line": 30,
    "snippet": "                raise ValueError('page range out of bounds')"
  },
  {
    "path": "app.py",
    "line": 31,
    "snippet": "            step = 1 if end >= start else -1"
  },
  {
    "path": "app.py",
    "line": 32,
    "snippet": "            for i in range(start, end + step, step):"
  },
  {
    "path": "app.py",
    "line": 33,
    "snippet": "                if i not in seen:"
  },
  {
    "path": "app.py",
    "line": 34,
    "snippet": "                    result.append(i - 1)"
  },
  {
    "path": "app.py",
    "line": 35,
    "snippet": "                    seen.add(i)"
  },
  {
    "path": "app.py",
    "line": 36,
    "snippet": "        else:"
  },
  {
    "path": "app.py",
    "line": 37,
    "snippet": "            i = int(part)"
  },
  {
    "path": "app.py",
    "line": 38,
    "snippet": "            if i < 1 or i > page_count:"
  },
  {
    "path": "app.py",
    "line": 39,
    "snippet": "                raise ValueError('page number out of bounds')"
  },
  {
    "path": "app.py",
    "line": 40,
    "snippet": "            if i not in seen:"
  },
  {
    "path": "app.py",
    "line": 41,
    "snippet": "                result.append(i - 1)"
  },
  {
    "path": "app.py",
    "line": 42,
    "snippet": "                seen.add(i)"
