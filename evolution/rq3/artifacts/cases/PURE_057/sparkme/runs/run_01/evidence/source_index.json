    "snippet": "def levenshtein(a, b):"
  },
  {
    "path": "app.py",
    "line": 76,
    "snippet": "    if len(a) < len(b):"
  },
  {
    "path": "app.py",
    "line": 77,
    "snippet": "        a, b = b, a"
  },
  {
    "path": "app.py",
    "line": 78,
    "snippet": "    previous = list(range(len(b) + 1))"
  },
  {
    "path": "app.py",
    "line": 79,
    "snippet": "    for i, ca in enumerate(a, 1):"
  },
  {
    "path": "app.py",
    "line": 80,
    "snippet": "        current = [i]"
  },
  {
    "path": "app.py",
    "line": 81,
    "snippet": "        for j, cb in enumerate(b, 1):"
  },
  {
    "path": "app.py",
    "line": 82,
    "snippet": "            current.append(min(previous[j] + 1, current[-1] + 1, previous[j - 1] + (ca != cb)))"
