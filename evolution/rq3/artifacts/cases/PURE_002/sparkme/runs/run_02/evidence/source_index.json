    "path": "app/templates/index.html",
    "line": 8,
    "snippet": "<section><h2>Products</h2><form method=\"post\" action=\"/products\"><input name=\"name\" placeholder=\"Product name\"><input name=\"sku\" placeholder=\"SKU\"><input name=\"barcode\" placeholder=\"Barcode\"><input name=\"category\" placeholder=\"Category\"><input name=\"price\" placeholder=\"Price\"><input name=\"stock\" placeholder=\"Stock\" type=\"number\"><label><input type=\"checkbox\" name=\"available\" checked> Available</label><button>Add product</button></form><ul>{% for p in d.products %}<li>{{ p.name }} ({{ p.sku }}) - {{ p.price }}{% if not p.available %} [unavailable]{% endif %}</li>{% endfor %}</ul></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 9,
    "snippet": "<section><h2>Cart</h2><form method=\"post\" action=\"/cart/add/1\"><input name=\"qty\" value=\"1\" type=\"number\"><button>Add product #1 to cart</button></form><p>Items in cart: {{ d.cart|length }}</p></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 10,
    "snippet": "<section><h2>Checkout</h2><form method=\"post\" action=\"/orders\"><input name=\"customer\" placeholder=\"Customer name\"><input name=\"address\" placeholder=\"Shipping address\"><input name=\"payment\" placeholder=\"Payment details\"><button>Place order</button></form></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 11,
    "snippet": "<section><h2>Import products</h2><form method=\"post\" action=\"/import/products\" enctype=\"multipart/form-data\"><input type=\"file\" name=\"file\"><button>Upload CSV</button></form></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 12,
    "snippet": "<section><h2>Orders</h2><ul>{% for o in d.orders %}<li>Order {{ o.id }} - {{ o.customer }} - {{ o.payment_status }}<form method=\"post\" action=\"/orders/{{ o.id }}/fail-payment\" style=\"display:inline\"><button>Simulate payment failure</button></form></li>{% endfor %}</ul></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 13,
    "snippet": "<section><h2>Notifications</h2><ul>{% for n in d.notifications %}<li>{{ n.kind }}: {{ n.message }} {% if n.unresolved %}(unresolved){% endif %}</li>{% endfor %}</ul></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 14,
    "snippet": "<section><h2>Audit log</h2><ul>{% for a in d.audit_log[-10:] %}<li>{{ a.time }} {{ a.entity }} {{ a.action }} {{ a.details }}</li>{% endfor %}</ul></section>"
  },
  {
    "path": "app/templates/index.html",
    "line": 15,
    "snippet": "</body></html>"
  },
